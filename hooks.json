{
  "antigravity-dev-suite-hooks": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "write_file",
        "hooks": [
          {
            "type": "command",
            "command": "bash ./scripts/auto_debug_runner.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "bash ./scripts/auto_debug_runner.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
