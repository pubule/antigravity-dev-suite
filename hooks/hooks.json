{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/dev-handoff-detect.js\"",
            "timeout": 5,
            "statusMessage": "Checking for /dev handoff..."
          }
        ]
      }
    ]
  }
}
